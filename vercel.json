        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, X-Admin-Key, X-Admin-Write-Key"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
